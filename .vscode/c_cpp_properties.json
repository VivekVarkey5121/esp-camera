{
    "configurations": [
        {
            "name": "ESP32 Arduino",
            "includePath": [
                "${workspaceFolder}/esp-camera",
                "${env:LOCALAPPDATA}/Arduino15/packages/esp32/hardware/esp32/*/cores/esp32",
                "${env:LOCALAPPDATA}/Arduino15/packages/esp32/hardware/esp32/*/variants/*",
                "${env:LOCALAPPDATA}/Arduino15/packages/esp32/hardware/esp32/*/libraries/*/src",
                "${env:LOCALAPPDATA}/Arduino15/packages/esp32/tools/esp32-arduino-libs/*/esp32/include",
                "${env:LOCALAPPDATA}/Arduino15/packages/esp32/tools/esp32-arduino-libs/*/esp32/include/**",
                "${env:LOCALAPPDATA}/Arduino15/libraries/*/src",
                "${env:USERPROFILE}/Documents/Arduino/libraries/*/src"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}/esp-camera",
                    "${env:LOCALAPPDATA}/Arduino15/packages/esp32/hardware/esp32/*",
                    "${env:LOCALAPPDATA}/Arduino15/packages/esp32/tools/esp32-arduino-libs/*/esp32",
                    "${env:LOCALAPPDATA}/Arduino15/libraries",
                    "${env:USERPROFILE}/Documents/Arduino/libraries"
                ]
            },
            "defines": [
                "ARDUINO",
                "ARDUINO_ARCH_ESP32"
            ],
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "windows-gcc-x64"
        }
    ],
    "version": 4
}
